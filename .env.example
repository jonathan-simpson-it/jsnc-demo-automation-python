# DeepSeek API key. Optional in open-source mode: users can bring their own
# key in the browser UI (sent per-request as the X-API-Key header, stored
# only client-side). When unset, requests without a user key return 402.
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.0

CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=pe_documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4
CACHE_DB_PATH=./data/llm_cache.db

ENABLE_BM25=true
ENABLE_LLM_REWRITE=false
ENABLE_HUMAN_REVIEW=false

# OneDrive OAuth (optional)
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

LOG_LEVEL=INFO

# Microsoft Graph mail (list mailbox + create drafts) -- application
# permissions Mail.Read + Mail.ReadWrite on the Azure app registration.
# GRAPH_MAILBOX is optional; falls back to the OneDrive-connected user.
# Without these, the /summary email workspace runs on demo mail: sample
# inbox rows and drafts stored locally in data/graph_drafts.db.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
